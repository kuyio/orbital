#!/usr/bin/env bun

import { readdir } from "node:fs/promises";
import path from "node:path";

const ICONS_DIR = path.resolve(import.meta.dir, "../node_modules/lucide-static/icons");
const CURRENT_ICONS = path.resolve(import.meta.dir, "../lib/orbital/icons.rb");
const OUTPUT = CURRENT_ICONS;

function snakeCase(name) {
  return name.replace(/-/g, "_");
}

function stripSizeAttrs(svg) {
  return svg
    .replace(/\s+width="24"/g, "")
    .replace(/\s+height="24"/g, "");
}

function cleanSvg(svg) {
  let cleaned = svg.trim();
  // Remove license comment line
  cleaned = cleaned.replace(/<!--.*?-->\n?/gs, "");
  // Strip width/height (CSS controls sizing)
  cleaned = stripSizeAttrs(cleaned);
  // Collapse to single line for the heredoc
  cleaned = cleaned.replace(/\n\s*/g, " ").trim();
  return cleaned;
}

async function loadLucideIcons() {
  const files = await readdir(ICONS_DIR);
  const svgFiles = files.filter((f) => f.endsWith(".svg")).sort();
  const icons = [];

  for (const file of svgFiles) {
    const name = file.replace(".svg", "");
    const content = await Bun.file(path.join(ICONS_DIR, file)).text();
    icons.push({ name, svg: cleanSvg(content) });
  }

  return icons;
}

async function extractBrandsMethods() {
  const content = await Bun.file(CURRENT_ICONS).text();
  const methods = [];
  const regex = /( {4}def self\.icon_brands__\w+\n[\s\S]*?end)\n/g;
  let match;
  while ((match = regex.exec(content)) !== null) {
    methods.push(match[1]);
  }
  return methods;
}

function generateMethod(prefix, name, svg) {
  const methodName = `${prefix}__${snakeCase(name)}`;
  return `    def self.${methodName}\n      <<~SVG.html_safe\n        ${svg}\n      SVG\n    end`;
}

async function main() {
  console.log("Loading Lucide icons...");
  const lucideIcons = await loadLucideIcons();
  console.log(`  Found ${lucideIcons.length} Lucide icons`);

  console.log("Extracting FA brands methods...");
  const brandsMethods = await extractBrandsMethods();
  console.log(`  Found ${brandsMethods.length} FA brands icons`);

  const lines = [
    "# frozen_string_literal: true",
    "",
    "# Auto-generated by bin/generate-icons — do not edit by hand.",
    `# Lucide v${(await Bun.file(path.resolve(import.meta.dir, "../node_modules/lucide-static/package.json")).json()).version} (${lucideIcons.length} icons) + FontAwesome brands (${brandsMethods.length} icons)`,
    "",
    "module Orbital",
    "  module Icons",
    "    def self.render(name)",
    "      normalized = name.to_s.tr('-', '_')",
    "",
    '      lucide = :"icon__#{normalized}"',
    "      return send(lucide) if respond_to?(lucide)",
    "",
    '      brands = :"icon_brands__#{normalized}"',
    "      return send(brands) if respond_to?(brands)",
    "",
    "      raise ArgumentError, \"Icon '#{name}' not found.\"",
    "    end",
    "",
    "    # ---- Lucide icons ----",
    "",
  ];

  for (const icon of lucideIcons) {
    lines.push(generateMethod("icon", icon.name, icon.svg));
    lines.push("");
  }

  lines.push("    # ---- FontAwesome brands icons ----");
  lines.push("");

  for (const method of brandsMethods) {
    lines.push(method);
    lines.push("");
  }

  lines.push("  end");
  lines.push("end");
  lines.push("");

  const output = lines.join("\n");
  await Bun.write(OUTPUT, output);

  const total = lucideIcons.length + brandsMethods.length;
  console.log(`\nGenerated ${OUTPUT}`);
  console.log(`  ${lucideIcons.length} Lucide + ${brandsMethods.length} FA brands = ${total} icon methods`);
}

main().catch((err) => {
  console.error(err);
  process.exit(1);
});
