{
  "name": "orbital",
  "description": "The Orbital View Components library",
  "license": "MIT",
  "version": "0.0.1",
  "author": {
    "name": "KUY.io Inc.",
    "email": "dev@kuy.io",
    "url": "https://kuy.io/"
  },
  "targets": {
    "js": {
      "source": "frontend/javascript/index.js",
      "distDir": "app/assets/javascripts/orbital/",
      "outputFormat": "global"
    },
    "css": {
      "source": "frontend/stylesheets/index.css",
      "distDir": "app/assets/stylesheets/orbital/"
    }
  },
  "exports": {
    "./theme": "./app/assets/stylesheets/orbital/theme.css",
    "./themes/blue": "./app/assets/stylesheets/orbital/themes/blue.css",
    "./themes/green": "./app/assets/stylesheets/orbital/themes/green.css",
    "./themes/rose": "./app/assets/stylesheets/orbital/themes/rose.css",
    "./themes/violet": "./app/assets/stylesheets/orbital/themes/violet.css",
    "./themes/orange": "./app/assets/stylesheets/orbital/themes/orange.css"
  },
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "scripts": {
    "watch": "parcel watch --no-hmr --no-cache",
    "build": "parcel build",
    "generate:icons": "bun bin/generate-icons"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@hotwired/stimulus": "^3.2.2"
  },
  "devDependencies": {
    "@parcel/transformer-sass": "2.16.4",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/bun": "latest",
    "baseline-browser-mapping": "^2.10.43",
    "caniuse-lite": "^1.0.30001805",
    "lucide-static": "^1.27.0",
    "parcel": "^2.16.4",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.3.2",
    "tw-animate": "^1.0.3"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}