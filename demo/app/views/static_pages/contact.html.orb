<DialogFrame>
  <Dialog open dismissible size=lg>
    <Dialog:Header>
      <Heading>Contact Us</Heading>
    </Dialog:Header>

    <div class="flex flex-col gap-4 w-full">
      <TextField name="email" label="Your email address"/>
      <TextField name="question" label="Your question" multiline=5/>

      <div class="flex gap-4">
        <Button variant="outline" data-action="orbital-dialog#close">Close</Button>
        <Button variant="primary">Send Message</Button>
      </div>
    </div>
  </Dialog>
</DialogFrame>