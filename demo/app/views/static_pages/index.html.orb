<AppFrame>
  <Hero>
    <a href="/components">
      <Badge variant="secondary">
        <Icon name="circle" size="xs" class="text-blue-500 mr-1"/>
        New Components: TextField, Badge, Icon and more
        <Icon name="arrow-right" size="xs" class="ml-1"/>
      </Badge>
    </a>

    <MarketingHeading class="max-w-4xl text-heavy">
      This could be your Design System
    </MarketingHeading>

    <Leade class="max-w-3xl">
      A set of beautifully designed components that you can customize, extend, and build on. Start here then make them your own. Open Source. Open Code.
    </Leade>

    <div class="flex w-full items-center justify-center gap-2 pt-2">
      <Button url="/quickstart">Get Started</Button>
      <Button variant="secondary" url="/components">View Components</Button>
    </div>
  </Hero>

  <div class="flex flex-col mx-auto py-6">
    <div class="grid grid-cols-3 gap-8">
      <div class="border p-4 rounded-lg flex flex-col gap-6 w-96">
        <Heading size="sm">Payment Method</Heading>
        <Text tone="subdued">
          All transactions are secure and encrypted. We do not store your credit card information.
        </Text>
        <TextField name="card_name" label="Name on card" placeholder="John Doe" />

        <div class="grid grid-cols-5 gap-4">
          <div class="col-span-4">
            <TextField name="card_number" label="Card number" placeholder="1234 1234 1234 1234" />
          </div>
          <TextField name="card_ccv" label="CCV" placeholder="123" type="password" />
        </div>

        <div class="grid grid-cols-3 gap-4">
          <TextField name="card_expiry_month" label="Expiry Month" placeholder="MM" />
          <TextField name="card_expiry_year" label="Expiry Year" placeholder="YYYY" />
          <TextField name="card_zip" label="ZIP / Postal" placeholder="12345"/>
        </div>

        <Separator/>

        <Heading size="sm">Billing Address</Heading>

        <CheckBox name="same_as_shipping" checked>
          Same as shipping address
        </CheckBox>

        <Separator/>

        <TextField name="comments" multiline=3 placeholder="any additional comments" />

        <div class="grid grid-cols-2 gap-4">
          <Button variant="primary">Submit</Button>
          <Button variant="outline">Cancel</Button>
        </div>
      </div>

      <div class="border p-4 rounded-lg flex flex-col gap-6 w-96">
        <div class="flex items-center gap-2">
          <Badge variant="secondary">
            <Icon name="check-circle" size="sm" class="text-green-500 mr-1"/>
            Successful
          </Badge>
          <Badge variant="outline">
            <Icon name="clock" size="sm" class="text-gray-500 mr-1"/>
            Scheduled
          </Badge>
          <Badge>
            <Spinner size="sm" />
            <span class="mx-1">Synchronizing</span>
          </Badge>
        </div>
        <TextField name="search" iconLeft="magnifying-glass" placeholder="Search..." labelHidden suffix="12 results"/>

        <div class="flex items-center gap-2">
          <Button variant="outline" size="icon"><Icon name="arrow-left" size=sm/></Button>

          <ButtonGroup>
            <Button variant="outline">1</Button>
            <Button variant="outline">2</Button>
            <Button variant="outline">3</Button>
            <Button variant="outline">24</Button>
          </ButtonGroup>

          <ButtonGroup>
            <Button variant="outline">Archive</Button>
            <Button variant="outline"><Icon name="ellipsis" size=sm/></Button>
          </ButtonGroup>

          <Button variant="outline" size="icon"><Icon name="arrow-right" size=sm/></Button>
        </div>

        <div class="flex items-center gap-2">
          <ButtonGroup>
            <Button variant="outline">
              <Icon name="robot"/>
              <Text>Copilot</Text>
            </Button>
            <Button variant="outline"><Icon name="chevron-down" size=sm/></Button>
          </ButtonGroup>
        </div>

        <div class="flex flex-col justify-center items-center gap-4 bg-gray-50 p-4 rounded-lg py-8">
          <Icon name="cloud-upload" size="lg" class="text-gray-400"/>
          <Text tone="subdued" class="text-center">
            Drag and drop files here or <a href="#" class="text-blue-500 underline">browse</a> to upload
          </Text>
        </div>

        <div class="flex flex-col justify-center items-center gap-6 py-8 rounded-lg border border-dashed p-4 ">
          <Button variant="secondary" size="icon">
            <Spinner/>
          </Button>
          <div class="flex flex-col gap-4 items-center">
            <Heading>Processing your request</Heading>
            <Text tone="subdued" class="text-center">
              Please wait while we process your request. This may take a few moments. Do not refresh or navigate away from this page.
            </Text>
          </div>
          <Button variant="outline">Cancel</Button>
        </div>


      </div>

      <div class="border p-4 rounded-lg flex flex-col gap-8 w-96 items-center justify-center">

        <Image asset="lift-off.svg" alt="Lift Off" class="w-52 h-52"/>

        <Text align="center" class="leading-relaxed" tone="subdued">
          You see, this is just a demo of Orbital's components. There is no backend here to process payments or handle data. But imagine what you could build with these components as your foundation!
        </Text>

        <Button url="https://github.com/kuyio/orb_template">Let's make it happen today!</Button>
      </div>
    </div>
  </d.>
</AppFrame>
